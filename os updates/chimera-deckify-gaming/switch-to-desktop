#!/bin/bash
# switch-to-desktop — same as Steam Switch to Desktop (CachyOS path → Hyprland).
in_gamescope() {
  pgrep -x gamescope >/dev/null 2>&1 && return 0
  pgrep -x gamescope-wl >/dev/null 2>&1 && return 0
  [[ -f /tmp/.gaming-session-active ]] && return 0
  return 1
}
if ! in_gamescope; then
  exit 0
fi
exec /usr/local/bin/hyperwebster-exit-gaming
