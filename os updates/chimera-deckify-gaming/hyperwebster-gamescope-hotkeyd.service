[Unit]
Description=HyperWebster gamescope exit hotkey (Super+Shift+R)
PartOf=gamescope-session.service
After=gamescope-session.service
BindsTo=gamescope-session.service

[Service]
Type=simple
ExecStart=/usr/local/bin/hyperwebster-gamescope-hotkeyd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=gamescope-session.service
