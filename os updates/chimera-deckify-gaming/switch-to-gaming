#!/bin/bash
# switch-to-gaming — queue SDDM restart into gamescope session.
set -euo pipefail

notify() {
  notify-send -u critical "Gaming Mode" "$1" 2>/dev/null || true
}

if ! [ -x /usr/local/bin/gaming-session-switch ]; then
  notify "switch helpers missing — re-run Deckify / Chimera from Additions"
  exit 1
fi

if ! [ -x /usr/local/bin/hyperwebster-restart-sddm ]; then
  notify "SDDM restart helper missing — run hyperwebster-update, then Deckify"
  exit 1
fi

if ! /usr/local/bin/hyperwebster-gaming-session >/dev/null 2>&1; then
  notify "No gamescope session installed — open Additions → Deckify / Chimera"
  exit 1
fi

# Confirm NOPASSWD before arming — otherwise we write conf and never switch.
if ! sudo -n /usr/local/bin/hyperwebster-restart-sddm --check; then
  notify "Cannot restart SDDM without a password — re-run Additions → Deckify"
  exit 1
fi

if ! sudo -n /usr/local/bin/gaming-session-switch gaming; then
  notify "Session switch failed (sudoers / SDDM). Check gaming-session-switch"
  exit 1
fi

# Marker for switch-to-desktop / DeckShift-era helpers (optional with gamescope
# process check, but keeps Super+Shift+R paths consistent).
touch /tmp/.gaming-session-active 2>/dev/null || true

notify "Switching to Starman…"

# Escape the controller-desktop cgroup. Guide+Start used to run this script as a
# child of that service, then `systemctl --user stop` killed the script before
# SDDM restarted — pad frozen, still on Hyprland. Queue stop+restart outside.
ENTER_CMD='systemctl --user stop hyperwebster-controller-desktop.service 2>/dev/null || true; exec sudo -n /usr/local/bin/hyperwebster-restart-sddm'

if command -v systemd-run >/dev/null 2>&1; then
  systemctl --user reset-failed hyperwebster-enter-gaming.service 2>/dev/null || true
  systemd-run --user --collect --unit=hyperwebster-enter-gaming \
    --description="Enter Starman / gamescope via SDDM" \
    /bin/bash -c "$ENTER_CMD"
else
  setsid -f /bin/bash -c "$ENTER_CMD" >/dev/null 2>&1 || true
fi
