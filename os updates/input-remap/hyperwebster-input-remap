#!/usr/bin/env bash
# hyperwebster-input-remap — Hyprland-flavoured gum TUI for keyd
# (keyboard + mouse button remapping that works on Wayland/TTY).
set -euo pipefail

CONF_DIR=/etc/keyd
CONF="$CONF_DIR/hyperwebster.conf"
PRESETS_DIR="${HYPERWEBSTER_INPUT_PRESETS:-$HOME/.local/share/hyperwebster/input-remap/presets}"
LAYER="${HOME}/.local/share/hyperwebster/input-remap"

CYAN=$'\033[38;5;81m'
DIM=$'\033[2m'
RST=$'\033[0m'
BOLD=$'\033[1m'

need_gum() {
  command -v gum >/dev/null 2>&1 || {
    echo "gum is required (ships with HyperWebster)." >&2
    exit 1
  }
}

as_root() {
  if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi
}

header() {
  clear 2>/dev/null || true
  gum style --border rounded --border-foreground 6 --padding "0 2" --margin "1 0" \
    "${BOLD}${CYAN}HyperWebster${RST}  input remap" \
    "${DIM}keyd · keyboard & mouse · Wayland / TTY${RST}"
}

status_line() {
  local st="not installed" svc="—"
  if command -v keyd >/dev/null 2>&1; then
    st="keyd $(keyd -v 2>/dev/null | head -1 || echo installed)"
    if systemctl is-active --quiet keyd 2>/dev/null; then
      svc="active"
    elif systemctl is-enabled --quiet keyd 2>/dev/null; then
      svc="enabled (stopped)"
    else
      svc="disabled"
    fi
  fi
  local maps="none"
  [[ -f "$CONF" ]] && maps="$(basename "$CONF")"
  gum style --foreground 8 "daemon: ${svc}   ·   config: ${maps}   ·   ${st}"
}

ensure_keyd() {
  if command -v keyd >/dev/null 2>&1; then
    return 0
  fi
  gum confirm "keyd is not installed. Install from official repos?" || return 1
  as_root pacman -S --needed --noconfirm keyd
  as_root install -d -m 0755 "$CONF_DIR"
  as_root systemctl enable --now keyd
}

write_conf() {
  local body=$1
  as_root install -d -m 0755 "$CONF_DIR"
  local tmp
  tmp=$(mktemp)
  cat > "$tmp" <<EOF
# HyperWebster input remap (managed by hyperwebster-input-remap).
# Edit via Super+Ctrl+I or: hyperwebster-input-remap
# Docs: man keyd / https://github.com/rvaiya/keyd

$body
EOF
  as_root install -m 0644 "$tmp" "$CONF"
  rm -f "$tmp"
  reload_keyd
}

reload_keyd() {
  if systemctl is-active --quiet keyd 2>/dev/null; then
    as_root keyd reload 2>/dev/null || as_root systemctl restart keyd
    gum style --foreground 2 "Reloaded keyd."
  else
    as_root systemctl enable --now keyd
    gum style --foreground 2 "Started keyd."
  fi
}

apply_preset() {
  local name=$1 file="$PRESETS_DIR/$1.conf"
  if [[ ! -f "$file" ]]; then
    gum style --foreground 1 "Preset missing: $file"
    return 1
  fi
  write_conf "$(cat "$file")"
  gum style --foreground 2 "Applied preset: $name"
}

pick_preset() {
  ensure_keyd || return 0
  [[ -d "$PRESETS_DIR" ]] || PRESETS_DIR="$LAYER/presets"
  local opts=()
  local f base
  for f in "$PRESETS_DIR"/*.conf; do
    [[ -f "$f" ]] || continue
    base=$(basename "$f" .conf)
    opts+=("$base")
  done
  if [[ ${#opts[@]} -eq 0 ]]; then
    gum style --foreground 1 "No presets found in $PRESETS_DIR"
    return 0
  fi
  local choice
  choice=$(gum choose --header "Apply preset (overwrites $CONF)" "${opts[@]}") || return 0
  apply_preset "$choice"
}

list_devices() {
  ensure_keyd || return 0
  header
  gum style --bold "Input devices (keyd -l)"
  echo
  keyd -l 2>/dev/null || as_root keyd -l
  echo
  gum style --foreground 8 "Mice must be listed with m:vid:pid in [ids] (wildcard * is keyboards only)."
  gum confirm "Back to menu?" >/dev/null || true
}

monitor_keys() {
  ensure_keyd || return 0
  header
  gum style --bold "Key / button monitor"
  gum style --foreground 8 "Press keys or mouse buttons. Ctrl+C to stop."
  echo
  as_root keyd monitor || true
}

edit_conf() {
  ensure_keyd || return 0
  if [[ ! -f "$CONF" ]]; then
    write_conf "$(cat <<'EOF'
[ids]
*

[main]
# Examples:
# capslock = esc
# leftmeta = layer(meta)
EOF
)"
  fi
  local editor="${EDITOR:-${VISUAL:-nano}}"
  # Edit a copy then install — avoids editors that cannot write as root cleanly.
  local tmp
  tmp=$(mktemp)
  cp "$CONF" "$tmp"
  "$editor" "$tmp" </dev/tty >/dev/tty || true
  if ! cmp -s "$tmp" "$CONF"; then
    as_root install -m 0644 "$tmp" "$CONF"
    reload_keyd
  fi
  rm -f "$tmp"
}

mouse_wizard() {
  ensure_keyd || return 0
  header
  gum style --bold "Mouse side-button remap"
  gum style --foreground 8 "1) Note your mouse id from the list (m:vid:pid)."
  echo
  keyd -l 2>/dev/null | gum pager || keyd -l
  echo
  local mid action target
  mid=$(gum input --placeholder "m:046d:b01d" --prompt "Mouse id › ") || return 0
  [[ -n "$mid" ]] || return 0
  action=$(gum choose --header "Side button to remap" \
    "mouse1 (often back / btn4)" \
    "mouse2 (often forward / btn5)" \
    "leftmouse" \
    "middlemouse" \
    "rightmouse") || return 0
  action=${action%% *}
  target=$(gum choose --header "Map to" \
    "C-c (copy)" \
    "C-v (paste)" \
    "C-z (undo)" \
    "leftmeta (Super)" \
    "escape" \
    "backspace" \
    "delete" \
    "custom…") || return 0
  if [[ "$target" == "custom…" ]]; then
    target=$(gum input --placeholder "C-S-s or macro(...)" --prompt "keyd action › ") || return 0
  else
    target=${target%% *}
  fi
  write_conf "$(cat <<EOF
[ids]
${mid}

[main]
${action} = ${target}
EOF
)"
  gum style --foreground 2 "Mouse remap written. Test the button; if the pointer breaks, remove $CONF and reload."
}

toggle_service() {
  ensure_keyd || return 0
  if systemctl is-active --quiet keyd 2>/dev/null; then
    as_root systemctl stop keyd
    gum style --foreground 3 "keyd stopped (remaps off)."
  else
    as_root systemctl enable --now keyd
    gum style --foreground 2 "keyd started."
  fi
}

clear_conf() {
  if [[ ! -f "$CONF" ]]; then
    gum style --foreground 8 "No HyperWebster keyd config."
    return 0
  fi
  gum confirm "Remove $CONF and reload keyd?" || return 0
  as_root rm -f "$CONF"
  reload_keyd
  gum style --foreground 2 "Cleared."
}

main_menu() {
  need_gum
  while true; do
    header
    status_line
    echo
    local choice
    choice=$(gum choose --header "What do you want to do?" \
      "Apply keyboard preset" \
      "Mouse side-button wizard" \
      "List devices" \
      "Monitor keys / buttons" \
      "Edit config ($CONF)" \
      "Reload keyd" \
      "Start / stop keyd" \
      "Clear HyperWebster remaps" \
      "Quit") || exit 0
    case "$choice" in
      "Apply keyboard preset") pick_preset; gum confirm "Continue?" >/dev/null || true ;;
      "Mouse side-button wizard") mouse_wizard; gum confirm "Continue?" >/dev/null || true ;;
      "List devices") list_devices ;;
      "Monitor keys / buttons") monitor_keys ;;
      "Edit config"*) edit_conf ;;
      "Reload keyd") ensure_keyd && reload_keyd; sleep 1 ;;
      "Start / stop keyd") toggle_service; sleep 1 ;;
      "Clear HyperWebster remaps") clear_conf; sleep 1 ;;
      "Quit") exit 0 ;;
    esac
  done
}

usage() {
  cat <<EOF
hyperwebster-input-remap — remap keyboard & mouse buttons (keyd + gum TUI)

  hyperwebster-input-remap           Interactive TUI
  hyperwebster-input-remap preset <name>
  hyperwebster-input-remap status
  hyperwebster-input-remap reload
  hyperwebster-input-remap help

Open from Hyprland: Super+Ctrl+I (floating terminal).
EOF
}

cmd=${1:-}
case "$cmd" in
  ""|tui|menu) main_menu ;;
  preset)
    need_gum
    ensure_keyd
    apply_preset "${2:?preset name required}"
    ;;
  status)
    if command -v keyd >/dev/null 2>&1 && systemctl is-active --quiet keyd; then
      echo active
      exit 0
    fi
    echo inactive
    exit 1
    ;;
  reload)
    reload_keyd
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
