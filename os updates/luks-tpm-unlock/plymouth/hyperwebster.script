# HyperWebster Plymouth — pitch-black Starman ASCII unlock splash.
# No bitmap astronaut; monospace art + passphrase field for TPM fallback.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
shortest = screen_width;
if (screen_height < screen_width) {
  shortest = screen_height;
}

# Monospace sizes scale with panel height (TV-readable).
fs_art = Math.Int(screen_height / 48);
if (fs_art < 14) {
  fs_art = 14;
}
if (fs_art > 28) {
  fs_art = 28;
}
fs_brand = Math.Int(screen_height / 36);
if (fs_brand < 20) {
  fs_brand = 20;
}
if (fs_brand > 40) {
  fs_brand = 40;
}
fs_sub = Math.Int(screen_height / 42);
if (fs_sub < 16) {
  fs_sub = 16;
}
if (fs_sub > 32) {
  fs_sub = 32;
}
fs_label = Math.Int(screen_height / 48);
if (fs_label < 16) {
  fs_label = 16;
}
if (fs_label > 28) {
  fs_label = 28;
}
fs_hint = Math.Int(screen_height / 56);
if (fs_hint < 13) {
  fs_hint = 13;
}
if (fs_hint > 22) {
  fs_hint = 22;
}

font_art = "JetBrainsMono Nerd Font " + fs_art;
font_brand = "JetBrainsMono Nerd Font Bold " + fs_brand;
font_sub = "JetBrainsMono Nerd Font " + fs_sub;
font_label = "JetBrainsMono Nerd Font " + fs_label;
font_hint = "JetBrainsMono Nerd Font " + fs_hint;

# Fallback if JetBrains isn't in the initramfs font set.
# Plymouth picks the first available face from the family string when possible;
# Noto Sans Mono ships in BASE_PKGS and is more likely in the initrd.
font_art_fb = "Noto Sans Mono " + fs_art;
font_brand_fb = "Noto Sans Mono Bold " + fs_brand;
font_sub_fb = "Noto Sans Mono " + fs_sub;
font_label_fb = "Noto Sans Mono " + fs_label;
font_hint_fb = "Noto Sans Mono " + fs_hint;

# Starman mark (same compact art as the live installer).
# Green on black — #9ece6a ≈ 0.62, 0.81, 0.42
art_r = 0.62;
art_g = 0.81;
art_b = 0.42;

art_lines[0] = "          .          ";
art_lines[1] = "         ...         ";
art_lines[2] = "     ..  ...  ..     ";
art_lines[3] = "    .oo.......oo.    ";
art_lines[4] = "    .o88o...o88o.    ";
art_lines[5] = "     .888o.o888.     ";
art_lines[6] = "      ..o888o..      ";
art_lines[7] = "        .....        ";
art_lines[8] = "         ...         ";
art_lines[9] = "          .          ";
art_count = 10;

art_images = [];
art_sprites = [];
art_h = 0;
art_w = 0;
for (i = 0; i < art_count; i++) {
  img = Image.Text(art_lines[i], art_r, art_g, art_b, 1.0, font_art);
  if (img.GetWidth() < 8) {
    img = Image.Text(art_lines[i], art_r, art_g, art_b, 1.0, font_art_fb);
  }
  art_images[i] = img;
  if (img.GetWidth() > art_w) {
    art_w = img.GetWidth();
  }
  art_h = art_h + img.GetHeight();
}

title.image = Image.Text("HYPERWEBSTER OS", art_r, art_g, art_b, 1.0, font_brand);
if (title.image.GetWidth() < 8) {
  title.image = Image.Text("HYPERWEBSTER OS", art_r, art_g, art_b, 1.0, font_brand_fb);
}
subtitle.image = Image.Text("STARMAN", 0.75, 0.75, 0.78, 1.0, font_sub);
if (subtitle.image.GetWidth() < 8) {
  subtitle.image = Image.Text("STARMAN", 0.75, 0.75, 0.78, 1.0, font_sub_fb);
}
unlock_label.image = Image.Text("enter disk passphrase", 0.82, 0.82, 0.84, 1.0, font_label);
if (unlock_label.image.GetWidth() < 8) {
  unlock_label.image = Image.Text("enter disk passphrase", 0.82, 0.82, 0.84, 1.0, font_label_fb);
}
unlock_hint.image = Image.Text(
  "usb keyboard recommended for controllers",
  0.45, 0.45, 0.48, 1.0, font_hint);
if (unlock_hint.image.GetWidth() < 8) {
  unlock_hint.image = Image.Text(
    "usb keyboard recommended for controllers",
    0.45, 0.45, 0.48, 1.0, font_hint_fb);
}

entry_src = Image("entry.png");
entry_w = Math.Int(screen_width * 0.32);
if (entry_w < 400) {
  entry_w = 400;
}
if (entry_w > 600) {
  entry_w = 600;
}
entry_h = Math.Int(entry_src.GetHeight() * (entry_w / entry_src.GetWidth()));
if (entry_h < 48) {
  entry_h = 48;
}
entry.image = entry_src.Scale(entry_w, entry_h);

block_gap = Math.Int(shortest * 0.014);
if (block_gap < 8) {
  block_gap = 8;
}

stack_h = art_h + block_gap + title.image.GetHeight()
  + Math.Int(block_gap * 0.4) + subtitle.image.GetHeight()
  + Math.Int(block_gap * 1.2) + unlock_label.image.GetHeight()
  + Math.Int(block_gap * 0.5) + entry.image.GetHeight()
  + Math.Int(block_gap * 0.8) + unlock_hint.image.GetHeight();
stack_top = screen_height / 2 - stack_h / 2;
if (stack_top < Math.Int(screen_height * 0.06)) {
  stack_top = Math.Int(screen_height * 0.06);
}

y = stack_top;
for (i = 0; i < art_count; i++) {
  art_sprites[i] = Sprite(art_images[i]);
  art_sprites[i].SetX(screen_width / 2 - art_images[i].GetWidth() / 2);
  art_sprites[i].SetY(y);
  art_sprites[i].SetOpacity(1);
  y = y + art_images[i].GetHeight();
}

title.sprite = Sprite(title.image);
title.sprite.SetX(screen_width / 2 - title.image.GetWidth() / 2);
title.sprite.SetY(y + block_gap);
title.sprite.SetOpacity(1);

subtitle.sprite = Sprite(subtitle.image);
subtitle.sprite.SetX(screen_width / 2 - subtitle.image.GetWidth() / 2);
subtitle.sprite.SetY(title.sprite.GetY() + title.image.GetHeight() + Math.Int(block_gap * 0.4));
subtitle.sprite.SetOpacity(1);

# Fake progress while cryptsetup waits on TPM / passphrase.
global.fake_progress_limit = 0.7;
global.fake_progress_duration = 15.0;
global.animation_frame = 0;
global.fake_progress = 0.0;
global.real_progress = 0.0;
global.fake_progress_active = 0;
global.fake_progress_start_time = 0.0;
global.password_shown = 0;
global.max_progress = 0.0;

fun update_progress_bar(progress) {
  if (progress > global.max_progress) {
    global.max_progress = progress;
    width = Math.Int(progress_bar.original_image.GetWidth() * progress);
    if (width < 1) {
      width = 1;
    }
    progress_bar.image = progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
  }
}

fun show_progress_bar() {
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
}

fun hide_progress_bar() {
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
}

fun show_password_dialog() {
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
  unlock_label.sprite.SetOpacity(1);
  unlock_hint.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  unlock_label.sprite.SetOpacity(0);
  unlock_hint.sprite.SetOpacity(0);
  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
}

fun start_fake_progress() {
  global.fake_progress_active = 1;
  global.animation_frame = 0;
  global.max_progress = 0.0;
  global.fake_progress = 0.0;
}

fun stop_fake_progress() {
  global.fake_progress_active = 0;
}

fun refresh_callback() {
  global.animation_frame++;
  if (global.fake_progress_active == 1) {
    elapsed_time = global.animation_frame / 50.0;
    time_ratio = elapsed_time / global.fake_progress_duration;
    if (time_ratio > 1.0) {
      time_ratio = 1.0;
    }
    eased_ratio = 1 - ((1 - time_ratio) * (1 - time_ratio));
    global.fake_progress = eased_ratio * global.fake_progress_limit;
    update_progress_bar(global.fake_progress);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Unlock dialog ---------------------------------------------------------
lock.image = Image("lock.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = screen_width / 2 - entry.image.GetWidth() / 2;
entry.y = subtitle.sprite.GetY() + subtitle.image.GetHeight()
  + Math.Int(block_gap * 1.2) + unlock_label.image.GetHeight()
  + Math.Int(block_gap * 0.5);
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

lock_height = entry.image.GetHeight() * 0.7;
lock_scale = lock_height / lock.image.GetHeight();
lock_width = lock.image.GetWidth() * lock_scale;
scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.x = entry.x - lock_width - Math.Int(block_gap * 1.1);
lock.y = entry.y + entry.image.GetHeight() / 2 - lock_height / 2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

unlock_label.sprite = Sprite(unlock_label.image);
unlock_label.sprite.SetX(screen_width / 2 - unlock_label.image.GetWidth() / 2);
unlock_label.sprite.SetY(entry.y - unlock_label.image.GetHeight() - Math.Int(block_gap * 0.5));
unlock_label.sprite.SetOpacity(0);

unlock_hint.sprite = Sprite(unlock_hint.image);
unlock_hint.sprite.SetX(screen_width / 2 - unlock_hint.image.GetWidth() / 2);
unlock_hint.sprite.SetY(entry.y + entry.image.GetHeight() + Math.Int(block_gap * 0.8));
unlock_hint.sprite.SetOpacity(0);

bullet.sprites = [];
bullet_size = Math.Int(entry.image.GetHeight() * 0.2);
if (bullet_size < 7) {
  bullet_size = 7;
}
if (bullet_size > 12) {
  bullet_size = 12;
}

fun display_normal_callback() {
  hide_password_dialog();
  mode = Plymouth.GetMode();
  if ((mode == "boot" || mode == "resume") && global.password_shown == 1) {
    show_progress_bar();
    start_fake_progress();
  }
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;
  stop_fake_progress();
  hide_progress_bar();
  show_password_dialog();

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }

  max_bullets = 28;
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets) {
    bullets_to_show = max_bullets;
  }

  gap = Math.Int(bullet_size * 0.65);
  if (gap < 4) {
    gap = 4;
  }
  for (index = 0; index < bullets_to_show; index++) {
    if (!bullet.sprites[index]) {
      scaled_bullet = bullet.image.Scale(bullet_size, bullet_size);
      bullet.sprites[index] = Sprite(scaled_bullet);
      bullet.x = entry.x + Math.Int(entry.image.GetWidth() * 0.05) + index * (bullet_size + gap);
      bullet.y = entry.y + entry.image.GetHeight() / 2 - bullet_size / 2;
      bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
    }
    bullet.sprites[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# --- Progress bar ----------------------------------------------------------
progress_box_src = Image("progress_box.png");
progress_box.image = progress_box_src.Scale(entry.image.GetWidth(), Math.Int(progress_box_src.GetHeight() * (entry.image.GetWidth() / progress_box_src.GetWidth())));
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = screen_width / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = entry.y + entry.image.GetHeight() / 2 - progress_box.image.GetHeight() / 2;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);
progress_box.sprite.SetOpacity(0);

progress_bar_h = Math.Int(progress_box.image.GetHeight() * 0.55);
if (progress_bar_h < 6) {
  progress_bar_h = 6;
}
progress_bar.original_image = Image("progress_bar.png").Scale(
  progress_box.image.GetWidth() - 4,
  progress_bar_h);
progress_bar.sprite = Sprite();
progress_bar.image = progress_bar.original_image.Scale(1, progress_bar.original_image.GetHeight());
progress_bar.x = progress_box.x + 2;
progress_bar.y = progress_box.y + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);
progress_bar.sprite.SetOpacity(0);

fun progress_callback(duration, progress) {
  if (global.fake_progress_start_time == 0.0) {
    global.fake_progress_start_time = duration;
  }
  global.real_progress = progress;
  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    stop_fake_progress();
    update_progress_bar(progress);
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- Messages --------------------------------------------------------------
message_sprite = Sprite();
message_sprite.SetPosition(Math.Int(screen_width * 0.03), Math.Int(screen_height * 0.03), 10000);

fun display_message_callback(text) {
  message = Image.Text(text, art_r, art_g, art_b, 1.0, font_hint);
  if (message.GetWidth() < 8) {
    message = Image.Text(text, art_r, art_g, art_b, 1.0, font_hint_fb);
  }
  message_sprite.SetImage(message);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

fun quit_callback() {
  for (i = 0; i < art_count; i++) {
    art_sprites[i].SetOpacity(1);
  }
  title.sprite.SetOpacity(1);
  subtitle.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);
