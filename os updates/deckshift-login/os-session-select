#!/bin/bash
# /usr/lib/os-session-select — Steam's "Exit to Desktop" handler.
# Arm desktop then queue SDDM restart immediately (avoid steam -shutdown race).
rm -f /tmp/.gaming-session-active
sudo -n /usr/local/bin/gaming-session-switch desktop 2>/dev/null || {
  echo "Warning: Failed to update session config"
}
nohup sudo -n /usr/local/bin/hyperwebster-restart-sddm &>/dev/null &
disown
exit 0
