#!/bin/bash
# gaming-session-switch — one-shot SDDM autologin arm for desktop↔gaming.
set -u

CONF="/etc/sddm.conf.d/zz-gaming-session.conf"
MARKER="/run/deckshift-session-switch"

if [[ $EUID -ne 0 ]]; then
  echo "Error: must run as root (callers use: sudo -n $0 ...)" >&2
  exit 1
fi

USER_NAME="${SUDO_USER:-}"
if [[ -z "$USER_NAME" ]]; then
  USER_NAME=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$3 != "sddm" && $3 != "" { print $3; exit }')
fi
if [[ -z "$USER_NAME" ]]; then
  echo "Error: cannot determine the user to autologin" >&2
  exit 1
fi

resolve_desktop_session() {
  local s
  for s in hyprland-uwsm hyprland; do
    if [[ -f "/usr/share/wayland-sessions/${s}.desktop" ]] \
      || [[ -f "/usr/local/share/wayland-sessions/${s}.desktop" ]]; then
      echo "$s"
      return 0
    fi
  done
  # Last resort — still write something explicit.
  echo "hyprland-uwsm"
}

case "${1:-}" in
  gaming)
    SESSION=$(/usr/local/bin/hyperwebster-gaming-session 2>/dev/null) || {
      echo "Error: no gamescope session installed (run hyperwebster-deckify-install or DeckShift)" >&2
      exit 1
    }
    ;;
  desktop) SESSION=$(resolve_desktop_session) ;;
  *)
    echo "Usage: $0 {gaming|desktop}" >&2
    exit 1
    ;;
esac

# zz-steamos-autologin.conf (from Switch-to-Desktop) sorts after this file and
# would override Session= on the next SDDM start.
rm -f /etc/sddm.conf.d/zz-steamos-autologin.conf

cat > "$CONF" << EOF
[Autologin]
User=${USER_NAME}
Session=${SESSION}
Relogin=false
EOF
sync
touch "$MARKER"
echo "Session set to: $1 mode ($SESSION, one-shot autologin armed)"
