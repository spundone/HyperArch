#!/usr/bin/env bash
# hyperwebster-caelestia-repair - reset broken caelestia user config to
# HyperWebster glass defaults without wiping wallpapers or named schemes.
#
# After PR #23, bright wallpapers + smartScheme (default true) flip Material You
# to light mode. Nexus Wallpaper & style then fills with white m3surface.
# jq ".mode=dark" alone is not enough if colours stay a light palette.
set -euo pipefail

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SHARE="${HOME}/.local/share/hyperwebster"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia"
HWSTATE="${XDG_STATE_HOME:-$HOME/.local/state}/hyperwebster"
DEFAULTS="$HERE/defaults"
[ -d "$DEFAULTS" ] || DEFAULTS="$SHARE/caelestia-repair/defaults"

HARD=0
NO_BLUR=0
NO_RESTART=0
RESEED_SCHEME=1  # default ON: always write a full dark palette, not just mode=

usage() {
  cat <<'EOF'
Usage: hyperwebster-caelestia-repair [options]

  Soft repair (default): kill shell, force smartScheme off, write full dark
  scheme seed, re-apply wallpaper with --no-smart, glass fonts/blur, restart.

  --hard              Also rewrite shell.json / shell-tokens.json from defaults
  --reseed-scheme     (default) Write full dark shadotheme seed as last scheme step
  --keep-scheme       Do not replace scheme.json colours (only force mode=dark)
  --no-blur           Skip hyperwebster-blur-toggle enable
  --no-restart        Do not kill/restart caelestia shell at the end
  -h, --help          Show this help
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --hard) HARD=1 ;;
    --reseed-scheme) RESEED_SCHEME=1 ;;
    --keep-scheme) RESEED_SCHEME=0 ;;
    --no-blur) NO_BLUR=1 ;;
    --no-restart) NO_RESTART=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "WARNING: $1 not found - skipping related step" >&2
    return 1
  }
}

run_sudo_patch() {
  local script="$1"
  [ -f "$script" ] || return 0
  if [ "$(id -u)" -eq 0 ]; then
    sh "$script" || true
  else
    sudo sh "$script" 2>/dev/null || sh "$script" 2>/dev/null || true
  fi
}

find_seed() {
  local cand
  for cand in \
    "$DEFAULTS/scheme-shadotheme.json" \
    "$HERE/../../assets/scheme-shadotheme.json" \
    "$SHARE/../assets/scheme-shadotheme.json" \
    /usr/share/hyperwebster/scheme-shadotheme.json
  do
    if [ -f "$cand" ]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

kill_shell() {
  export LANG="${LANG:-en_US.UTF-8}"
  case "$LANG" in
    *.UTF-8*|*.utf8*) ;;
    *) export LANG=en_US.UTF-8 ;;
  esac
  qs -c caelestia kill 2>/dev/null || true
  # Wait until the old instance is actually gone (stock kill is racy).
  local i
  for i in $(seq 1 40); do
    qs -c caelestia ipc show >/dev/null 2>&1 || break
    sleep 0.1
  done
  sleep 0.2
}

write_full_dark_scheme() {
  local seed=""
  seed=$(find_seed) || seed=""
  mkdir -p "$STATE"
  if [ -n "$seed" ]; then
    cp -a "$seed" "$STATE/scheme.json"
    # Ensure mode is dark even if a seed copy was edited.
    if need_cmd jq; then
      tmp=$(mktemp)
      jq '.mode = "dark"' "$STATE/scheme.json" > "$tmp" && mv "$tmp" "$STATE/scheme.json"
    else
      sed -i 's/"mode"[[:space:]]*:[[:space:]]*"light"/"mode": "dark"/g' "$STATE/scheme.json"
    fi
    echo ":: wrote full dark scheme from $(basename "$seed")"
  else
    echo "WARNING: dark scheme seed not found - forcing mode=dark only" >&2
    if [ -f "$STATE/scheme.json" ] && need_cmd jq; then
      tmp=$(mktemp)
      jq '.mode = "dark"' "$STATE/scheme.json" > "$tmp" && mv "$tmp" "$STATE/scheme.json"
    elif [ -f "$STATE/scheme.json" ]; then
      sed -i 's/"mode"[[:space:]]*:[[:space:]]*"light"/"mode": "dark"/g' "$STATE/scheme.json"
    fi
  fi
}

echo "==> HyperWebster caelestia repair"

# ── Backup ──────────────────────────────────────────────────────────────────
BK="$HWSTATE/caelestia-repair-$(date +%Y%m%d%H%M%S)"
mkdir -p "$BK"
for f in shell.json shell-tokens.json hypr-vars.conf hypr-user.conf hypr-vars.lua; do
  [ -f "$CFG/$f" ] && cp -a "$CFG/$f" "$BK/" && echo "    backed up $f"
done
[ -f "$STATE/scheme.json" ] && cp -a "$STATE/scheme.json" "$BK/" && echo "    backed up scheme.json"
echo ":: backup -> $BK"

mkdir -p "$CFG" "$STATE" "$HWSTATE"

# ── Kill shell first so FileView cannot race-rewrite scheme.json ────────────
echo ":: stopping caelestia shell before config rewrite"
kill_shell

# ── shell.json first (smartScheme MUST be false before any wallpaper call) ──
SHELLJSON="$CFG/shell.json"
if [ "$HARD" -eq 1 ] && [ -f "$DEFAULTS/shell.json" ]; then
  if [ -f "$SHELLJSON" ] && need_cmd jq; then
    tmp=$(mktemp)
    jq -s '
      .[0] as $def | .[1] as $live |
      $def
      | if ($live.launcher != null) then .launcher = $live.launcher else . end
      | if ($live.bar != null) then .bar = $live.bar else . end
      | if ($live.general != null) then .general = $live.general else . end
      | if ($live.session != null) then .session = $live.session else . end
    ' "$DEFAULTS/shell.json" "$SHELLJSON" > "$tmp" && mv "$tmp" "$SHELLJSON"
  else
    cp -a "$DEFAULTS/shell.json" "$SHELLJSON"
  fi
  echo ":: shell.json rewritten from defaults (--hard)"
elif [ ! -f "$SHELLJSON" ] && [ -f "$DEFAULTS/shell.json" ]; then
  cp -a "$DEFAULTS/shell.json" "$SHELLJSON"
  echo ":: shell.json created from defaults"
fi

if [ -f "$SHELLJSON" ] && need_cmd jq; then
  tmp=$(mktemp)
  jq '
    .appearance = (.appearance // {})
    | .appearance.transparency = {
        enabled: true,
        base: 0.72,
        layers: 0.35
      }
    | .appearance.rounding = (.appearance.rounding // {})
    | .appearance.rounding.scale = (.appearance.rounding.scale // 0)
    | .appearance.font = (.appearance.font // {})
    | .appearance.font.headline = ((.appearance.font.headline // {}) + {family: "JetBrainsMono Nerd Font"})
    | .appearance.font.title = ((.appearance.font.title // {}) + {family: "JetBrainsMono Nerd Font"})
    | .appearance.font.body = ((.appearance.font.body // {}) + {family: "JetBrainsMono Nerd Font"})
    | .appearance.font.label = ((.appearance.font.label // {}) + {family: "JetBrainsMono Nerd Font"})
    | .appearance.font.mono = ((.appearance.font.mono // {}) + {family: "JetBrainsMono Nerd Font"})
    | .appearance.font.icon = ((.appearance.font.icon // {}) + {family: "Material Symbols Outlined"})
    | .background = (.background // {})
    | .background.wallpaperEnabled = true
    | .services = (.services // {})
    | .services.smartScheme = false
  ' "$SHELLJSON" > "$tmp" && mv "$tmp" "$SHELLJSON"
  echo ":: shell.json glass + fonts + wallpaper + smartScheme=false"
fi

TOKENS="$CFG/shell-tokens.json"
if { [ "$HARD" -eq 1 ] || [ ! -f "$TOKENS" ]; } && [ -f "$DEFAULTS/shell-tokens.json" ]; then
  cp -a "$DEFAULTS/shell-tokens.json" "$TOKENS"
  echo ":: shell-tokens.json restored from defaults"
fi

# ── Dark scheme: full palette last (never mode-only on a light colour map) ──
# Do NOT call `caelestia scheme set -m dark` here: if mode is already dark it
# early-returns without rewriting colours, and dynamic+smart can race light.
if [ "$RESEED_SCHEME" -eq 1 ]; then
  write_full_dark_scheme
else
  if [ -f "$STATE/scheme.json" ] && need_cmd jq; then
    tmp=$(mktemp)
    jq '.mode = "dark"' "$STATE/scheme.json" > "$tmp" && mv "$tmp" "$STATE/scheme.json"
    echo ":: scheme mode=dark (--keep-scheme; colours unchanged)"
  fi
fi

# ── Re-apply current wallpaper with --no-smart so bright walls stay dark ───
WALL_PATH=""
if [ -f "$STATE/wallpaper/path.txt" ]; then
  WALL_PATH=$(tr -d '\n' < "$STATE/wallpaper/path.txt" | sed 's/[[:space:]]*$//')
fi
if [ -n "$WALL_PATH" ] && [ -f "$WALL_PATH" ] && need_cmd caelestia; then
  caelestia wallpaper -f "$WALL_PATH" --no-smart 2>/dev/null \
    || caelestia wallpaper -f "$WALL_PATH" 2>/dev/null \
    || true
  echo ":: wallpaper re-applied with --no-smart: $WALL_PATH"
  # Wallpaper CLI may rewrite scheme for dynamic; stamp dark seed again LAST.
  if [ "$RESEED_SCHEME" -eq 1 ]; then
    write_full_dark_scheme
  fi
fi

# ── Theme / Colours patches ─────────────────────────────────────────────────
# Strip Colours.transparency from Theme.barBg first - that circular binding
# leaves Theme.size undefined (NsOverlay barHeight TypeError).
THEME_QML=/etc/xdg/quickshell/caelestia/services/Theme.qml
if [ -f "$THEME_QML" ] && grep -q 'Colours.transparency' "$THEME_QML" 2>/dev/null; then
  if [ -f "$THEME_QML.pre-hyperwebster-barbg" ]; then
    run_sudo_patch /bin/true 2>/dev/null || true
    sudo cp -a "$THEME_QML.pre-hyperwebster-barbg" "$THEME_QML" 2>/dev/null || true
    echo ":: restored Theme.qml from pre-hyperwebster-barbg (size crash)"
  fi
fi
# Drop monitor overlays that shadow global shell.json (HDMI-A-1 etc.).
if [ -d "$CFG/monitors" ]; then
  mbk="$HWSTATE/monitors-bak-$(date +%Y%m%d%H%M%S)"
  mkdir -p "$HWSTATE"
  cp -a "$CFG/monitors" "$mbk"
  rm -rf "$CFG/monitors"
  echo ":: moved monitor overlays aside -> $mbk"
fi
run_sudo_patch "$SHARE/appearance-page/patch-theme-font.sh"
run_sudo_patch "$HERE/../appearance-page/patch-theme-font.sh"
# Safe barBg (no Colours.transparency) BEFORE size bump.
run_sudo_patch "$SHARE/blur-toggle/patch-theme-nsbar-blur.sh"
run_sudo_patch "$HERE/../blur-toggle/patch-theme-nsbar-blur.sh"
run_sudo_patch "$SHARE/blur-toggle/patch-theme-nsbar-size.sh"
run_sudo_patch "$HERE/../blur-toggle/patch-theme-nsbar-size.sh"
run_sudo_patch "$SHARE/blur-toggle/patch-colours-nsbar-blur.sh"
run_sudo_patch "$HERE/../blur-toggle/patch-colours-nsbar-blur.sh"

# ── Blur toggle ─────────────────────────────────────────────────────────────
if [ "$NO_BLUR" -eq 0 ]; then
  if command -v hyperwebster-blur-toggle >/dev/null 2>&1; then
    hyperwebster-blur-toggle enable || true
  elif [ -f "$SHARE/blur-toggle/hyperwebster-blur-toggle" ]; then
    sh "$SHARE/blur-toggle/hyperwebster-blur-toggle" enable || true
  elif [ -f "$HERE/../blur-toggle/hyperwebster-blur-toggle" ]; then
    sh "$HERE/../blur-toggle/hyperwebster-blur-toggle" enable || true
  fi
fi

if command -v hyperwebster-app-theme-sync >/dev/null 2>&1; then
  hyperwebster-app-theme-sync 2>/dev/null || true
fi

# ── Final dark stamp (after blur/theme tools that might touch config) ───────
if [ "$RESEED_SCHEME" -eq 1 ]; then
  write_full_dark_scheme
fi
# smartScheme must still be false after any tool merges.
if [ -f "$SHELLJSON" ] && need_cmd jq; then
  tmp=$(mktemp)
  jq '.services = (.services // {}) | .services.smartScheme = false' "$SHELLJSON" > "$tmp" \
    && mv "$tmp" "$SHELLJSON"
fi

# ── Verify ──────────────────────────────────────────────────────────────────
echo ":: verification"
if [ -f "$STATE/scheme.json" ] && need_cmd jq; then
  jq -r '"    scheme mode=\(.mode) surface=\(.colours.surface // .colours.Surface // "?") name=\(.name)"' \
    "$STATE/scheme.json" || true
fi
if [ -f "$SHELLJSON" ] && need_cmd jq; then
  jq -r '"    smartScheme=\(.services.smartScheme) transparency=\(.appearance.transparency.enabled)"' \
    "$SHELLJSON" || true
fi

# ── Restart shell ───────────────────────────────────────────────────────────
if [ "$NO_RESTART" -eq 0 ]; then
  kill_shell
  if command -v caelestia >/dev/null 2>&1; then
    setsid caelestia shell -d >/dev/null 2>&1 || caelestia shell -d >/dev/null 2>&1 || true
  fi
  echo ":: caelestia shell restarted"
else
  echo ":: restart skipped - run: Ctrl+Super+Alt+R"
fi

echo
echo "Done. Backup: $BK"
echo "Nexus should be dark glass. Keep Settings → Services → Smart colour scheme OFF"
echo "for bright wallpapers, or they will flip light again."
echo "If the bar is still a hairline on 4K: Super+Ctrl+H → scale 1.5 or 2."
exit 0
