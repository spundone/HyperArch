# profile uses the SOUTH/EAST/WEST/NORTH names — prefer those.
_BTN_PREFER = (
    "BTN_SOUTH", "BTN_EAST", "BTN_WEST", "BTN_NORTH",
    "BTN_MODE", "BTN_START", "BTN_SELECT",
    "BTN_TL", "BTN_TR", "BTN_THUMBL", "BTN_THUMBR",
