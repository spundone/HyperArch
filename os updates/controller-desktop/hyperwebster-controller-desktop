            # WlSessionLock ignores uinput — feed PAM via qs IPC.
            digit = str(self.lock_digit)
            out = qs("lock", "feed", digit)
            if "No running" in out or "Unknown function" in out or "no such" in out.lower():
                log(f"lock feed failed: {out!r}")
                self.tap_key(getattr(ecodes, f"KEY_{self.lock_digit}"))
