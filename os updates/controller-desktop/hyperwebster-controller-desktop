        log(f"unknown action: {action}")

    def resolve_name(self, name: str | None) -> str | None:
        if not name:
            return None
        binds = self.active_bindings()
        if self.locked:
            return binds.get(name)
        # Layer priority: Guide > Select > Start > Y > base
        for prefix, active in (
            ("GUIDE+", self.guide_down),
            ("SELECT+", self.select_down),
            ("START+", self.start_down),
            ("Y+", self.y_down),
        ):
            if not active:
                continue
            combo = f"{prefix}{name}"
            if combo in binds:
                return binds[combo]
        return binds.get(name)

    def resolve_btn(self, code: int) -> str | None:
        return self.resolve_name(btn_name(code))

    def _mark_chord(self) -> None:
        if self.guide_down:
            self.guide_chorded = True
        if self.select_down:
            self.select_chorded = True
        if self.start_down:
            self.start_chorded = True
        if self.y_down:
            self.y_chorded = True

    def on_button(self, code: int, value: int) -> None:
        name = btn_name(code)

        # Hold-modifiers: release alone fires base bind; with another button = layer.
        if name == "BTN_MODE":
            if value == 1:
                self.guide_down = True
                self.guide_chorded = False
                if self.locked:
                    action = self.resolve_name("BTN_MODE")
                    if action:
                        self.do_action(action)
            else:
                if self.locked:
                    self.guide_down = False
                    return
                if self.guide_down and not self.guide_chorded:
                    self.do_action(self.bindings.get("BTN_MODE") or "launcher")
                self.guide_down = False
            return

        if not self.locked:
            if name == "BTN_SELECT":
                if value == 1:
                    self.select_down = True
                    self.select_chorded = False
                else:
                    if self.select_down and not self.select_chorded:
                        self.do_action(self.bindings.get("BTN_SELECT") or "dashboard")
                    self.select_down = False
                return
            if name == "BTN_START":
                if value == 1:
                    self.start_down = True
                    self.start_chorded = False
                else:
                    if self.start_down and not self.start_chorded:
                        self.do_action(self.bindings.get("BTN_START") or "overview")
                    self.start_down = False
                return
            if name == "BTN_NORTH":
                if value == 1:
                    self.y_down = True
                    self.y_chorded = False
                else:
                    if self.y_down and not self.y_chorded:
                        self.do_action(self.bindings.get("BTN_NORTH") or "settings")
                    self.y_down = False
                return

        if value != 1:
            return

        # Digital trigger buttons on some pads
        if name in ("BTN_TL2", "BTN_TRIGGER_HAPPY1") and not self.locked:
            self._mark_chord()
            self.do_action(self.resolve_name("TRIGGER_LT") or "mouse_right")
            return
        if name in ("BTN_TR2", "BTN_TRIGGER_HAPPY2"):
            self._mark_chord()
            if self.locked:
                self.do_action(self.resolve_name("TRIGGER_RT") or "lock_digit_confirm")
            else:
                self.do_action(self.resolve_name("TRIGGER_RT") or "mouse_left")
            return

        if not self.locked:
            self._mark_chord()
        action = self.resolve_btn(code)
        if action:
            if self.locked:
                log(f"lock btn {name} → {action}")
            self.do_action(action)

    def on_hat(self, code: int, value: int) -> None:
        if code == ecodes.ABS_HAT0X:
            self.hat["x"] = value
            key = f"ABS_HAT0X:{value}"
        elif code == ecodes.ABS_HAT0Y:
            self.hat["y"] = value
            key = f"ABS_HAT0Y:{value}"
        else:
            return
        if value == 0:
            if code == ecodes.ABS_HAT0Y:
                self._hat_y_action = None
                self._hat_repeat_at = 0.0
            return
        if not self.locked:
            self._mark_chord()
        action = self.resolve_name(key)
        if action:
            self.do_action(action)
            # Hold-to-repeat for vertical scroll (and any other Y bind).
            if code == ecodes.ABS_HAT0Y and action.startswith("scroll_"):
                self._hat_y_action = action
                self._hat_repeat_at = time.monotonic() + 0.35

    def tick_hat_repeat(self) -> None:
        if self.paused or self.locked or not self._hat_y_action:
            return
        if self.hat.get("y", 0) == 0:
            self._hat_y_action = None
            return
        now = time.monotonic()
        if now < self._hat_repeat_at:
            return
        self.do_action(self._hat_y_action)
        self._hat_repeat_at = now + 0.09

    def on_axis(self, code: int, value: int) -> None:
        n = self.axis_norm(code, value)
        if code == ecodes.ABS_X:
            self.axes["x"] = n
        elif code == ecodes.ABS_Y:
            self.axes["y"] = n
        elif code == ecodes.ABS_RX:
            self.axes["rx"] = n
        elif code == ecodes.ABS_RY:
            self.axes["ry"] = n
        elif code == ecodes.ABS_Z:
            self._trigger_edge("lt", n, "TRIGGER_LT")
        elif code == ecodes.ABS_RZ:
            self._trigger_edge("rt", n, "TRIGGER_RT")

    def _trigger_edge(self, which: str, norm: float, bind_name: str) -> None:
        # On lock screen RT confirms the pending digit (analog triggers).
        if self.paused:
            return
        down = norm >= self.trigger_threshold
        prev = self.trigger_down[which]
        self.trigger_down[which] = down
        if down and not prev:
            if self.locked:
                if which == "rt":
                    self.do_action("lock_digit_confirm")
                elif which == "lt":
                    self.do_action("lock_backspace")
                return
            self._mark_chord()
            action = self.resolve_name(bind_name)
            if action:
                self.do_action(action)

    def tick_mouse(self) -> None:
        if self.paused or self.locked:
            return
        lx, ly = self.axes["x"], self.axes["y"]
        rx, ry = self.axes["rx"], self.axes["ry"]
        dx = rx * self.mouse_speed * 1.2
        dy = ry * self.mouse_speed * 1.2
        if self.guide_down or not self.mouse_with_guide:
            dx += lx * self.mouse_speed
            dy += ly * self.mouse_speed
        self.move_mouse(dx, dy)

    def refresh_pause(self) -> None:
        # Lock wins over game-focus pause: we must keep the grab to type a PIN.
        locked = session_locked()
        if locked != self.locked:
            self.locked = locked
            if locked:
                self.lock_digit = 0
                self.paused = False
                self.guide_down = False
                self.set_grab(True)
                log("lock screen — PIN pad mode (D-pad digit, A/RT confirm, B/LT delete, Start unlock)")
                qs("lock", "pending", "0")
            else:
                log("unlocked — desktop mapping")
                self.guide_down = False
        if self.locked:
            return
        should = focused_should_pause()
        if should != self.paused:
            self.paused = should
            self.set_grab(not should)
            log("paused for game focus" if should else "resumed desktop mapping")

    def run(self) -> int:
        if gamescope_active():
            log("gamescope / gaming session active — exiting (Steam owns controllers)")
            return 0
        self.setup_uinput()
        if not self.open_pad():
            log("no gamepad found yet; waiting for one…")
        elif not self.paused:
            self.set_grab(True)
        last_scan = 0.0
        last_pause = 0.0
        last_mouse = 0.0
        while not self._stop:
            if gamescope_active():
                log("gamescope appeared — exiting")
                break
            now = time.monotonic()
            if self.dev is None and now - last_scan > 2.0:
                last_scan = now
                self.open_pad()
                if self.dev and not self.paused:
                    self.set_grab(True)
            if now - last_pause > 0.35:
                last_pause = now
                if self.dev:
                    self.refresh_pause()
            if self.dev is None:
                time.sleep(0.3)
                continue
            if now - last_mouse > 0.016:
                last_mouse = now
                self.tick_mouse()
                self.tick_hat_repeat()
            r, _, _ = select.select([self.dev.fd], [], [], 0.02)
            if not r:
                continue
            try:
                for event in self.dev.read():
                    if self.paused and not self.locked:
                        continue
                    if event.type == ecodes.EV_KEY:
                        self.on_button(event.code, event.value)
                    elif event.type == ecodes.EV_ABS:
                        if event.code in (ecodes.ABS_HAT0X, ecodes.ABS_HAT0Y):
                            self.on_hat(event.code, event.value)
                        else:
                            self.on_axis(event.code, event.value)
            except OSError:
                log("device disconnected")
                try:
                    if self.grabbed:
                        self.dev.ungrab()
                except Exception:
                    pass
                self.dev = None
                self.grabbed = False
        self.shutdown()
        return 0

    def shutdown(self) -> None:
        self._stop = True
        try:
            if self.dev and self.grabbed:
                self.dev.ungrab()
        except Exception:
            pass
        if self.ui:
            self.ui.close()


def which(name: str) -> str | None:
    from shutil import which as _which
    return _which(name)


def write_pid() -> None:
    PIDFILE.write_text(str(os.getpid()))


def main() -> int:
    if os.geteuid() == 0:
        log("do not run as root")
        return 1
    profile = load_profile()
    LAYER.mkdir(parents=True, exist_ok=True)
    if not PROFILE_PATH.is_file():
        PROFILE_PATH.write_text(json.dumps(DEFAULT_PROFILE, indent=2) + "\n")

    ctl = ControllerDesktop(profile)

    def handle_sig(_s, _f):
        ctl._stop = True

    signal.signal(signal.SIGTERM, handle_sig)
    signal.signal(signal.SIGINT, handle_sig)
    write_pid()
    try:
        return ctl.run()
    finally:
        try:
            PIDFILE.unlink(missing_ok=True)
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main())
