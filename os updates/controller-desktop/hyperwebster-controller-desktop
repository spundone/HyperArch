def btn_name(code: int) -> str | None:
    name = ecodes.BTN.get(code) or ecodes.KEY.get(code)
    if isinstance(name, (tuple, list)):
        for pref in _BTN_PREFER:
            if pref in name:
                return pref
        return name[0]
    return name


