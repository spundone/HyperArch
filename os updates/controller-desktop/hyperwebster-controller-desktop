def log(msg: str) -> None:
    print(f"[controller-desktop] {msg}", flush=True)


def load_profile() -> dict:
    if PROFILE_PATH.is_file():
        try:
            data = json.loads(PROFILE_PATH.read_text())
            base = dict(DEFAULT_PROFILE)
            base.update({k: v for k, v in data.items() if k not in ("bindings", "lock_bindings")})
            binds = dict(DEFAULT_PROFILE["bindings"])
            binds.update(data.get("bindings") or {})
            base["bindings"] = binds
            lock_binds = dict(DEFAULT_PROFILE["lock_bindings"])
            lock_binds.update(data.get("lock_bindings") or {})
            base["lock_bindings"] = lock_binds
            return base
        except Exception as e:
            log(f"profile read failed ({e}); using defaults")
    return dict(DEFAULT_PROFILE)


def hypr_env() -> dict:
    env = os.environ.copy()
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        hypr = runtime / "hypr"
        if hypr.is_dir():
            # Prefer the newest instance (active session).
            children = sorted(
                (c for c in hypr.iterdir() if c.is_dir()),
                key=lambda p: p.stat().st_mtime,
                reverse=True,
            )
            if children:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = children[0].name
    if not env.get("WAYLAND_DISPLAY"):
        for name in ("wayland-1", "wayland-0"):
            if (runtime / name).exists():
                env["WAYLAND_DISPLAY"] = name
                break
    return env


def hyprctl(*args: str) -> str:
    try:
        r = subprocess.run(
            ["hyprctl", *args],
            capture_output=True,
            text=True,
            timeout=1.5,
            env=hypr_env(),
        )
        return (r.stdout or "").strip()
    except Exception:
        return ""


def qs(*args: str) -> str:
    try:
        r = subprocess.run(
            ["qs", "-c", "caelestia", "ipc", "call", *args],
            capture_output=True,
            text=True,
            timeout=1.5,
            env=hypr_env(),
        )
        return (r.stdout or "").strip()
    except Exception:
        return ""


def run_detached(cmd: list[str]) -> None:
    subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=hypr_env(),
        start_new_session=True,
    )


def gamescope_active() -> bool:
    """True while Starman/gamescope owns the seat.

    Clears a leftover /tmp/.gaming-session-active when gamescope is gone so the
    desktop mapper can start again after unclean Game Mode exits.
    """
    try:
        r = subprocess.run(
            ["pgrep", "-x", "gamescope"],
            capture_output=True,
            timeout=0.5,
        )
        running = r.returncode == 0
    except Exception:
        running = False
    if not running:
        try:
            r = subprocess.run(
                ["pgrep", "-x", "gamescope-wl"],
                capture_output=True,
                timeout=0.5,
            )
            running = r.returncode == 0
        except Exception:
            pass

    flag = Path("/tmp/.gaming-session-active")
    if flag.exists() and not running:
        try:
            flag.unlink()
            log("cleared stale /tmp/.gaming-session-active")
        except OSError:
            pass
        return False
    return running or flag.exists()


def locked_hint() -> bool | None:
    """Return session LockedHint from loginctl, or None if unavailable."""
    try:
        r = subprocess.run(
            ["loginctl", "list-sessions", "--no-legend"],
            capture_output=True,
            text=True,
            timeout=1.0,
        )
        uid = str(os.getuid())
        for line in (r.stdout or "").splitlines():
            parts = line.split()
            if len(parts) < 3:
                continue
            sid, suid = parts[0], parts[1]
            if suid != uid:
                continue
            info = subprocess.run(
                ["loginctl", "show-session", sid, "-p", "LockedHint", "-p", "Type", "-p", "Active"],
                capture_output=True,
                text=True,
                timeout=1.0,
            )
            props = {}
            for pline in (info.stdout or "").splitlines():
                if "=" in pline:
                    k, v = pline.split("=", 1)
                    props[k] = v
            if props.get("Active") != "yes":
                continue
            if props.get("Type") not in {"wayland", "x11"}:
                continue
            return props.get("LockedHint", "no").lower() in {"yes", "1", "true"}
    except Exception:
        return None
    return None


def session_locked() -> bool:
    """True when the graphical session is actually locked.

    Caelestia uses WlSessionLock; Hyprland often leaves loginctl LockedHint at
    no while qs lock.isLocked is true. Treat LockedHint=yes as definitive, then
    OR in qs — never trust LockedHint=no alone (that used to skip PIN mode).
    """
    if locked_hint() is True:
        return True
    out = qs("lock", "isLocked").lower().strip()
    return out in {"true", "1", "yes"}


def focused_should_pause() -> bool:
    raw = hyprctl("activewindow", "-j")
    if not raw:
        return False
    try:
        win = json.loads(raw)
    except Exception:
        return False
    cls = str(win.get("class") or "")
    title = str(win.get("title") or "")
    if cls in PAUSE_CLASS_EXACT:
        return True
    for p in PAUSE_CLASS_PREFIXES:
        if cls.startswith(p):
            return True
    for h in PAUSE_TITLE_HINTS:
        if h in title and ("steam_app" in cls or "Proton" in title or "Wine" in title):
            return True
    if win.get("fullscreen") and cls and cls.lower() not in {
        "firefox", "chromium", "google-chrome", "brave-browser", "zen",
        "kitty", "Alacritty", "org.gnome.Nautilus", "thunar",
        "caelestia-launcher", "steam",
    }:
        if "steam" in cls.lower() or "game" in cls.lower() or "unity" in cls.lower():
            return True
    return False


def is_gamepad(dev: InputDevice) -> bool:
    name = (dev.name or "").lower()
    if "keyd virtual" in name or "virtual pointer" in name:
        return False
    if "hyperwebster controller" in name:
        return False
    caps = dev.capabilities()
    keys = set(caps.get(ecodes.EV_KEY, []))
    if ecodes.BTN_GAMEPAD in keys or ecodes.BTN_SOUTH in keys or ecodes.BTN_A in keys:
        return True
    if ecodes.BTN_MODE in keys and ecodes.BTN_START in keys:
        return True
    abs_codes = {
        (a[0] if isinstance(a, tuple) else a)
        for a in caps.get(ecodes.EV_ABS, [])
    }
    if ecodes.ABS_HAT0X in abs_codes and (
        ecodes.BTN_TL in keys or ecodes.BTN_TR in keys or ecodes.BTN_SELECT in keys
    ):
        return True
    return False


def find_gamepads() -> list[InputDevice]:
    found: list[InputDevice] = []
    for path in list_devices():
        try:
            d = InputDevice(path)
        except Exception:
            continue
        if is_gamepad(d):
            found.append(d)
    return found


class ControllerDesktop:
    def __init__(self, profile: dict):
        self.profile = profile
        self.bindings: dict = profile.get("bindings") or {}
        self.lock_bindings: dict = profile.get("lock_bindings") or {}
        self.deadzone = float(profile.get("deadzone", 0.28))
        self.mouse_speed = float(profile.get("mouse_speed", 14))
        self.mouse_with_guide = bool(profile.get("mouse_with_guide", True))
        self.trigger_threshold = float(profile.get("trigger_click_threshold", 0.75))
        self.ui: UInput | None = None
        self.dev: InputDevice | None = None
        self.grabbed = False
        self.paused = False
        self.locked = False
        self.guide_down = False
        self.select_down = False
        self.start_down = False
        self.y_down = False
        self.guide_chorded = False
        self.select_chorded = False
        self.start_chorded = False
        self.y_chorded = False
        self.lock_digit = 0
        self.hat = {"x": 0, "y": 0}
        self.axes = {"x": 0.0, "y": 0.0, "rx": 0.0, "ry": 0.0}
        self.trigger_down = {"lt": False, "rt": False}
        self._stop = False
        self._axis_info: dict[int, tuple[int, int]] = {}
        self._hat_repeat_at = 0.0
        self._hat_y_action: str | None = None

    def setup_uinput(self) -> None:
        keys = [
            ecodes.KEY_ENTER, ecodes.KEY_ESC, ecodes.KEY_TAB,
            ecodes.KEY_LEFT, ecodes.KEY_RIGHT, ecodes.KEY_UP, ecodes.KEY_DOWN,
            ecodes.KEY_F10, ecodes.KEY_SPACE, ecodes.KEY_BACKSPACE,
            ecodes.KEY_LEFTMETA, ecodes.KEY_LEFTCTRL, ecodes.KEY_PRINT,
            ecodes.KEY_VOLUMEUP, ecodes.KEY_VOLUMEDOWN, ecodes.KEY_MUTE,
            ecodes.KEY_BRIGHTNESSUP, ecodes.KEY_BRIGHTNESSDOWN,
            ecodes.KEY_PLAYPAUSE, ecodes.KEY_NEXTSONG, ecodes.KEY_PREVIOUSSONG,
            ecodes.KEY_LEFTSHIFT, ecodes.KEY_LEFTALT, ecodes.KEY_C, ecodes.KEY_V,
            ecodes.BTN_LEFT, ecodes.BTN_RIGHT, ecodes.BTN_MIDDLE,
        ]
        keys.extend(getattr(ecodes, f"KEY_{i}") for i in range(10))
        caps = {
            ecodes.EV_KEY: keys,
            ecodes.EV_REL: [
                ecodes.REL_X, ecodes.REL_Y,
                ecodes.REL_WHEEL, ecodes.REL_HWHEEL,
            ],
        }
        self.ui = UInput(caps, name="HyperWebster Controller Desktop", version=0x3)

    def open_pad(self) -> bool:
        pads = find_gamepads()
        if not pads:
            return False
        pads.sort(key=lambda d: (
            0 if any(s in (d.name or "").lower() for s in (
                "xbox", "gamepad", "controller", "games", "dualshock",
                "dualsense", "8bitdo", "x-box",
            )) else 1,
            d.name or "",
        ))
        self.dev = pads[0]
        absinfo = self.dev.capabilities().get(ecodes.EV_ABS, [])
        for item in absinfo:
            code = item[0] if isinstance(item, tuple) else item
            info = item[1] if isinstance(item, tuple) and len(item) > 1 else None
            if info is not None:
                self._axis_info[code] = (info.min, info.max)
        log(f"using {self.dev.path} ({self.dev.name})")
        return True

    def set_grab(self, on: bool) -> None:
        if not self.dev or self.grabbed == on:
            return
        try:
            self.dev.grab() if on else self.dev.ungrab()
            self.grabbed = on
            log("grab on" if on else "grab off (pass-through to Steam/games)")
        except OSError as e:
            log(f"grab failed: {e}")

    def tap_key(self, keycode: int) -> None:
        if not self.ui:
            return
        self.ui.write(ecodes.EV_KEY, keycode, 1)
        self.ui.syn()
        self.ui.write(ecodes.EV_KEY, keycode, 0)
        self.ui.syn()

    def tap_chord(self, *keycodes: int) -> None:
        if not self.ui:
            return
        for k in keycodes:
            self.ui.write(ecodes.EV_KEY, k, 1)
        self.ui.syn()
        for k in reversed(keycodes):
            self.ui.write(ecodes.EV_KEY, k, 0)
        self.ui.syn()

    def click_mouse(self, button: int) -> None:
        if not self.ui:
            return
        self.ui.write(ecodes.EV_KEY, button, 1)
        self.ui.syn()
        self.ui.write(ecodes.EV_KEY, button, 0)
        self.ui.syn()

    def move_mouse(self, dx: float, dy: float) -> None:
        if not self.ui:
            return
        ix, iy = int(dx), int(dy)
        if ix == 0 and iy == 0:
            return
        if ix:
            self.ui.write(ecodes.EV_REL, ecodes.REL_X, ix)
        if iy:
            self.ui.write(ecodes.EV_REL, ecodes.REL_Y, iy)
        self.ui.syn()

    def scroll_wheel(self, ticks: int) -> None:
        if not self.ui or not ticks:
            return
        self.ui.write(ecodes.EV_REL, ecodes.REL_WHEEL, int(ticks))
        self.ui.syn()

    def scroll_wheel_h(self, ticks: int) -> None:
        if not self.ui or not ticks:
            return
        self.ui.write(ecodes.EV_REL, ecodes.REL_HWHEEL, int(ticks))
        self.ui.syn()

    def axis_norm(self, code: int, value: int) -> float:
        lo, hi = self._axis_info.get(code, (-32768, 32767))
        if hi == lo:
            return 0.0
        # Triggers are often 0..255 with rest at 0
        if lo >= 0 and hi > lo and code in (ecodes.ABS_Z, ecodes.ABS_RZ, getattr(ecodes, "ABS_BRAKE", -1), getattr(ecodes, "ABS_GAS", -2)):
            return max(0.0, min(1.0, (value - lo) / float(hi - lo)))
        mid = (hi + lo) / 2.0
        span = (hi - lo) / 2.0
        v = (value - mid) / span
        if abs(v) < self.deadzone:
            return 0.0
        sign = 1 if v > 0 else -1
        return sign * min(1.0, (abs(v) - self.deadzone) / (1.0 - self.deadzone))

    def active_bindings(self) -> dict:
        return self.lock_bindings if self.locked else self.bindings

    def do_action(self, action: str) -> None:
        if not action:
            return
        if action.startswith("key:"):
            name = action.split(":", 1)[1]
            code = getattr(ecodes, name, None)
            if code is not None:
                self.tap_key(code)
            return
        if action == "launcher":
            qs("drawers", "toggle", "launcher")
            return
        if action == "dashboard":
            qs("drawers", "toggle", "dashboard")
            return
        if action == "session_menu":
            # Soft power / session surface — dashboard is the QAM analogue.
            qs("drawers", "toggle", "dashboard")
            return
        if action == "overview":
            run_detached(["qs", "ipc", "-c", "overview", "call", "overview", "toggle"])
            return
        if action == "settings":
            run_detached(["hyperwebster-settings"]) if which("hyperwebster-settings") else self.tap_key(ecodes.KEY_F10)
            return
        if action == "keybinds":
            help_bin = Path.home() / ".local/bin/hyperwebster-keybinds"
            run_detached([str(help_bin) if help_bin.is_file() else "hyperwebster-keybinds"])
            return
        if action == "workspace_prev":
            hyprctl("dispatch", "workspace", "-1")
            return
        if action == "workspace_next":
            hyprctl("dispatch", "workspace", "+1")
            return
        if action == "focus_l":
            hyprctl("dispatch", "movefocus", "l")
            return
        if action == "focus_r":
            hyprctl("dispatch", "movefocus", "r")
            return
        if action == "focus_u":
            hyprctl("dispatch", "movefocus", "u")
            return
        if action == "focus_d":
            hyprctl("dispatch", "movefocus", "d")
            return
        if action == "movewindow_l":
            hyprctl("dispatch", "movewindow", "l")
            return
        if action == "movewindow_r":
            hyprctl("dispatch", "movewindow", "r")
            return
        if action == "movewindow_u":
            hyprctl("dispatch", "movewindow", "u")
            return
        if action == "movewindow_d":
            hyprctl("dispatch", "movewindow", "d")
            return
        if action == "togglefloat":
            hyprctl("dispatch", "togglefloating")
            return
        if action == "togglesplit":
            hyprctl("dispatch", "togglesplit")
            return
        if action == "pin_window":
            hyprctl("dispatch", "pin")
            return
        if action == "toggle_group":
            hyprctl("dispatch", "togglegroup")
            return
